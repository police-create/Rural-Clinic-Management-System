# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# If MONGODB_URI is empty or fails, backend will start an embedded MongoDB instance in development/test
MONGODB_URI=mongodb://127.0.0.1:27017/rural_clinic_db

# JWT & Security Secrets
JWT_ACCESS_SECRET=super_secret_jwt_access_key_rural_clinic_2026_india
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_rural_clinic_2026_india
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Clinic Defaults
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_CURRENCY=INR

